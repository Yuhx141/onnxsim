index 0000000..c0d00df
--- /dev/null
+++ b/onnxruntime/core/providers/webgpu/nn/lrn.h
@@ -0,0 +1,46 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+#pragma once
+
+#include "core/providers/webgpu/program.h"
+#include "core/providers/webgpu/webgpu_kernel.h"
+
+namespace onnxruntime {
+namespace webgpu {
+
+class LRNProgram final : public Program<LRNProgram> {
+ public:
+  LRNProgram() : Program{"LRN"} {}
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES({"output_size", ProgramUniformVariableDataType::Uint32},
+                                          {"channels", ProgramUniformVariableDataType::Uint32},
+                                          {"stride", ProgramUniformVariableDataType::Uint32},
+                                          {"lo", ProgramUniformVariableDataType::Uint32},
+                                          {"hi", ProgramUniformVariableDataType::Uint32},
+                                          {"alpha_over_size", ProgramUniformVariableDataType::Float32},
+                                          {"beta", ProgramUniformVariableDataType::Float32},
+                                          {"bias", ProgramUniformVariableDataType::Float32});
+};
+
+// ONNX LRN over the channel axis (NCHW, or NHWC for the internal NHWC domain):
+//   y = x / (bias + alpha / size * sum_{j in [c - floor((size-1)/2), c + ceil((size-1)/2)]} x_j^2) ^ beta
+template <bool is_nhwc>
+class LRN final : public WebGpuKernel {
+ public:
+  LRN(const OpKernelInfo& info) : WebGpuKernel(info) {
+    alpha_ = info.GetAttrOrDefault<float>("alpha", 0.0001f);
+    beta_ = info.GetAttrOrDefault<float>("beta", 0.75f);
+    bias_ = info.GetAttrOrDefault<float>("bias", 1.0f);
+    size_ = info.GetAttr<int64_t>("size");
+  }
+
+  Status ComputeInternal(ComputeContext& context) const override;
+
+ private:
+  float alpha_, beta_, bias_;
+  int64_t size_;
+};
+
+}  // namespace webgpu
+}  // namespace onnxruntime
