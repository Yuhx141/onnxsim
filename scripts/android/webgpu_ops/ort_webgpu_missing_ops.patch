new file mode 100644
index 0000000..43681f1
--- /dev/null
+++ b/onnxruntime/core/providers/webgpu/nn/lrn.cc
@@ -0,0 +1,86 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+#include "core/providers/webgpu/nn/lrn.h"
+#include "core/providers/webgpu/shader_helper.h"
+#include "core/providers/webgpu/webgpu_supported_types.h"
+#include "core/providers/webgpu/webgpu_utils.h"
+
+namespace onnxruntime {
+namespace webgpu {
+
+#define WEBGPU_LRN_VERSIONED_KERNEL(start, end, domain, is_nhwc)                      \
+  ONNX_OPERATOR_VERSIONED_KERNEL_EX(                                                  \
+      LRN, domain, start, end, kWebGpuExecutionProvider,                              \
+      (*KernelDefBuilder::Create()).TypeConstraint("T", WebGpuSupportedFloatTypes()), \
+      LRN<is_nhwc>);
+
+#define WEBGPU_LRN_KERNEL(version, domain, is_nhwc)                                   \
+  ONNX_OPERATOR_KERNEL_EX(                                                            \
+      LRN, domain, version, kWebGpuExecutionProvider,                                 \
+      (*KernelDefBuilder::Create()).TypeConstraint("T", WebGpuSupportedFloatTypes()), \
+      LRN<is_nhwc>);
+
+WEBGPU_LRN_VERSIONED_KERNEL(1, 12, kOnnxDomain, false)
+WEBGPU_LRN_KERNEL(13, kOnnxDomain, false)
+WEBGPU_LRN_VERSIONED_KERNEL(1, 12, kMSInternalNHWCDomain, true)
+WEBGPU_LRN_KERNEL(13, kMSInternalNHWCDomain, true)
+
+Status LRNProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  const auto& x = shader.AddInput("x", ShaderUsage::UseUniform | ShaderUsage::UseElementTypeAlias);
+  const auto& y = shader.AddOutput("y", ShaderUsage::UseUniform | ShaderUsage::UseElementTypeAlias);
+
+  // The sum of squares is accumulated in f32 whatever the tensor type is.
+  shader.MainFunctionBody() << shader.GuardAgainstOutOfBoundsWorkgroupSizes("uniforms.output_size")
+                            << "  let p = global_idx % uniforms.stride;\n"
+                               "  let c = (global_idx / uniforms.stride) % uniforms.channels;\n"
+                               "  let base = global_idx - c * uniforms.stride;\n"
+                               "  let first = select(0u, c - uniforms.lo, c >= uniforms.lo);\n"
+                               "  let last = min(uniforms.channels - 1u, c + uniforms.hi);\n"
+                               "  var sum = 0.0;\n"
+                               "  for (var j = first; j <= last; j++) {\n"
+                               "    let v = f32("
+                            << x.GetByOffset("base + j * uniforms.stride") << ");\n"
+                            << "    sum += v * v;\n"
+                               "  }\n"
+                               "  let scale = pow(uniforms.bias + uniforms.alpha_over_size * sum, -uniforms.beta);\n"
+                            << "  " << y.SetByOffset("global_idx", "x_element_t(f32(" + x.GetByOffset("global_idx") + ") * scale)");
+  return Status::OK();
+}
+
+template <bool is_nhwc>
+Status LRN<is_nhwc>::ComputeInternal(ComputeContext& context) const {
+  const auto* input = context.Input(0);
+  const TensorShape& shape = input->Shape();
+  ORT_ENFORCE(shape.NumDimensions() >= 3, "LRN input must have at least 3 dimensions (N, C, ...).");
+  ORT_ENFORCE(size_ > 0, "LRN size must be positive.");
+  auto* output = context.Output(0, shape);
+  const int64_t total = shape.Size();
+  if (total == 0) {
+    return Status::OK();
+  }
+  // Distance in elements between consecutive channels of the same position.
+  const uint32_t channels = onnxruntime::narrow<uint32_t>(is_nhwc ? shape[shape.NumDimensions() - 1] : shape[1]);
+  const uint32_t stride = is_nhwc ? 1u : onnxruntime::narrow<uint32_t>(shape.SizeFromDimension(2));
+  const uint32_t lo = onnxruntime::narrow<uint32_t>((size_ - 1) / 2);
+  const uint32_t hi = onnxruntime::narrow<uint32_t>(size_ / 2);  // ceil((size - 1) / 2)
+
+  LRNProgram program;
+  program
+      .CacheHint(is_nhwc ? "NHWC" : "NCHW")
+      .AddInput({input, ProgramTensorMetadataDependency::Type})
+      .AddOutput({output, ProgramTensorMetadataDependency::None})
+      .SetDispatchGroupSize((total + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE)
+      .AddUniformVariables({{static_cast<uint32_t>(total)},
+                            {channels},
+                            {stride},
+                            {lo},
+                            {hi},
+                            {alpha_ / static_cast<float>(size_)},
+                            {beta_},
+                            {bias_}});
+  return context.RunProgram(program);
+}
+
+}  // namespace webgpu
+}  // namespace onnxruntime
diff --git a/onnxruntime/core/providers/webgpu/nn/lrn.h b/onnxruntime/core/providers/webgpu/nn/lrn.h
