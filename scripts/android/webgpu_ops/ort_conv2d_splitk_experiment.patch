+uint32_t Conv2dSplitKDimInner(uint32_t dim_inner, uint32_t splits, uint32_t tile_inner) {
+  const uint32_t per_split = (dim_inner + splits - 1) / splits;
+  return (per_split + tile_inner - 1) / tile_inner * tile_inner;
+}
+
+Status Conv2dSplitKReduceProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  const auto& partial = shader.AddInput("partial", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias | ShaderUsage::UseElementTypeAlias);
+  const ShaderVariableHelper* bias = has_bias_ ? &shader.AddInput("bias", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias) : nullptr;
+  const auto& result = shader.AddOutput("result", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias);
+  shader.MainFunctionBody() << shader.GuardAgainstOutOfBoundsWorkgroupSizes("uniforms.output_size")
+                            << "  var value = " << partial.GetByOffset("global_idx") << ";\n"
+                            << "  for (var s = 1u; s < " << splits_ << "u; s = s + 1u) {\n"
+                            << "    value = value + " << partial.GetByOffset("global_idx + s * uniforms.slice_size") << ";\n"
+                            << "  }\n";
+  if (bias != nullptr) {
+    shader.MainFunctionBody() << "  value = value + " << bias->GetByOffset("global_idx % uniforms.n4") << ";\n";
+  }
+  shader.MainFunctionBody() << "  " << GetActivationSnippet(activation_, "vec4<partial_element_t>", "partial_element_t") << "\n"
+                            << "  " << result.SetByOffset("global_idx", "value");
+  return Status::OK();
+}
+
+uint32_t ChooseConv2dSplitK(uint32_t dim_a_outer, uint32_t dim_b_outer, uint32_t dim_inner, uint32_t batch_size, bool is_vec4, bool is_channels_last) {
+  // ORT_WGPU_CONV_SPLITK: unset/0/1 = off, "auto" = heuristic, N >= 2 = force N slices (experiments).
+  const char* env = std::getenv("ORT_WGPU_CONV_SPLITK");
+  if (env == nullptr || !is_vec4 || !is_channels_last || batch_size != 1) {
+    return 1;
+  }
+  uint32_t splits = 1;
+  if (std::strcmp(env, "auto") == 0) {
+    // Workgroups without splitting: 8x8 threads, each 4 rows x 4 columns -> 32x32 outputs per workgroup.
+    const uint32_t workgroups = ((dim_b_outer + 31) / 32) * ((dim_a_outer + 31) / 32);
+    constexpr uint32_t kTargetWorkgroups = 256;
+    constexpr uint32_t kMinInnerPerSplit = 256;
+    while (workgroups * splits < kTargetWorkgroups && splits < 16 && dim_inner / (splits * 2) >= kMinInnerPerSplit) {
+      splits *= 2;
+    }
+  } else {
+    splits = static_cast<uint32_t>(std::atoi(env));
+  }
+  return splits > 1 ? splits : 1;
+}
+
+Status RunConv2dMMSplitK(ComputeContext& context, const Activation& activation, const std::vector<const Tensor*>& inputs, const std::vector<uint32_t>& pads, const std::vector<uint32_t>& strides, const std::vector<uint32_t>& dilations, Tensor* output, uint32_t dim_a_outer, uint32_t dim_b_outer, uint32_t dim_inner, uint32_t splits, const std::vector<TensorShape>& modified_input_output_shapes) {
+  const bool has_bias = inputs.size() > 2;
+  constexpr uint32_t kTileInner = 32;  // 8 * inner_element_size(4) on the 8x8 workgroup
+  const uint32_t split_dim_inner = Conv2dSplitKDimInner(dim_inner, splits, kTileInner);
+  const uint32_t effective_splits = (dim_inner + split_dim_inner - 1) / split_dim_inner;
+
+  Tensor partial = context.CreateGPUTensor(output->DataType(), TensorShape({static_cast<int64_t>(effective_splits), 1, static_cast<int64_t>(dim_a_outer), static_cast<int64_t>(dim_b_outer)}));
+  const std::vector<const Tensor*> partial_inputs = {inputs[0], inputs[1]};
+  const std::vector<TensorShape> partial_shapes = {modified_input_output_shapes[0], modified_input_output_shapes[1], modified_input_output_shapes[has_bias ? 3 : 2]};
+  Activation no_activation;
+  no_activation.activation_params_.values_[0] = 0.0f;  // fully initialize the union: it is part of the program cache key
+  no_activation.activation_params_.values_[1] = 0.0f;
+  // the partial stage writes raw sums; bias and activation are applied by the reduce stage
+  Conv2dMMProgram partial_program = CreateConv2dMMProgram(no_activation, partial_inputs, pads, strides, dilations, &partial, dim_a_outer, dim_b_outer, dim_inner, /*is_channels_last=*/true, partial_shapes, effective_splits);
+  ORT_RETURN_IF_ERROR(context.RunProgram(partial_program));
+
+  const uint32_t slice_size = dim_a_outer * dim_b_outer / 4;
+  Conv2dSplitKReduceProgram reduce{activation, has_bias, effective_splits};
+  reduce.CacheHint(activation.ToString(), has_bias, effective_splits)
+      .AddInput({&partial, ProgramTensorMetadataDependency::Type, TensorShape({static_cast<int64_t>(effective_splits) * slice_size}), 4});
+  if (has_bias) {
+    reduce.AddInput({inputs[2], ProgramTensorMetadataDependency::Type, TensorShape({static_cast<int64_t>(dim_b_outer / 4)}), 4});
+  }
+  reduce.AddOutput({output, ProgramTensorMetadataDependency::None, TensorShape({static_cast<int64_t>(slice_size)}), 4})
+      .SetDispatchGroupSize((slice_size + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE)
+      .AddUniformVariables({{slice_size}, {slice_size}, {dim_b_outer / 4}});
+  return context.RunProgram(reduce);
+}
