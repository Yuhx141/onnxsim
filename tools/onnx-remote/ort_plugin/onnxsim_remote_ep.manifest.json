{
  "schema_version": 1,
  "name": "onnxsim_remote",
  "status": "legacy_source_abi_adapter",
  "ort_version": "requires_legacy_internal_ep_headers",
  "entrypoint": "onnxsim::ort_remote::CreateRemoteExecutionProviderFromOptions",
  "registration": "internal_cpp",
  "public_plugin_entrypoints": [],
  "supported_ops": ["Identity", "Relu", "Add", "Mul"],
  "tensor_types": ["float32"],
  "profiling": {
    "levels": ["off", "summary", "detailed"],
    "transport": "response_profile_events",
    "onnxsim_bridge": true
  },
  "transport": {
    "protocol": "onnx-remote-v5",
    "default_host": "127.0.0.1",
    "default_port": 39501
  },
  "public_plugin_migration": {
    "required_exports": ["CreateEpFactories", "ReleaseEpFactory"],
    "api": "onnxruntime_ep_c_api.h",
    "blocked_by": "matching public ORT EP C API headers and an OrtEp implementation"
  }
}
